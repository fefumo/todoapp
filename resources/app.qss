
QWidget {
    background-color: {{background}};
    color: {{text}};
}


/* Pages */

QWidget#mainPage,
QWidget#editPage {
    background-color: {{background}};
}


/* Tabs */

QTabWidget::pane {
    border: 1px solid {{border}};
}

QTabBar::tab {
    background-color: {{surface}};
    color: {{muted}};

    border: 1px solid {{border}};
    border-radius: 5px;

    padding: 6px 12px;
}

QTabBar::tab:hover {
    color: {{text}};
    border-color: {{muted}};
}

QTabBar::tab:selected {
    color: {{text}};
    border-bottom: 2px solid {{accent}};
}


/* Task list */

QTableWidget#taskTable {
    background-color: {{surface}};
    color: {{text}};

    border: 1px solid {{border}};
    border-radius: 5px;

    gridline-color: {{border}};
    outline: none;

    selection-background-color: {{accent}};
    selection-color: {{background}};
}

/* QTableWidget#taskTable::item:hover { */
/*     background-color: {{border}}; */
/* } */

QTableWidget#taskTable::item:selected {
    color: {{background}};
}

/* Horizontal and vertical headers */
QTableWidget#taskTable QHeaderView::section {
    background-color: {{surface}};
    color: {{text}};

    padding: 6px;
    border: none;
    border-right: 1px solid {{border}};
    border-bottom: 1px solid {{border}};
}

/* Top-left corner between the headers */
QTableWidget#taskTable QTableCornerButton::section {
    background-color: {{surface}};
    border: none;
    border-right: 1px solid {{border}};
    border-bottom: 1px solid {{border}};
}

/* Button panel */

QWidget#editButtonsPanel {
    background-color: {{surface}};

    border: 1px solid {{border}};
    border-radius: 5px;
}


/* Buttons */

QPushButton {
    background-color: {{surface}};
    color: {{text}};

    border: 1px solid {{border}};
    border-radius: 5px;

    padding: 6px 10px;
}

QPushButton:hover {
    background-color: {{border}};
}

QPushButton:pressed {
    border-color: {{accent}};
}

QPushButton:disabled {
    color: {{border}};
}


/* Create button */

QPushButton[role="primary"] {
    border-color: {{accent}};
}

QPushButton[role="primary"]:pressed {
    background-color: {{accent}};
    border-color: {{text}};
    color: {{background}};
}


/* Delete button */

QPushButton[role="danger"] {
    color: {{danger}};
    border-color: {{danger}};
}


QPushButton[role="danger"]:pressed {
    background-color: {{danger}};
    color: {{background}};
}


/* Text inputs */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: {{surface}};
    color: {{text}};

    border: 1px solid {{border}};
    border-radius: 5px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: {{accent}};
}


/* Scrollbars */

QScrollBar:vertical {
    width: 8px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background-color: {{border}};
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{accent}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
